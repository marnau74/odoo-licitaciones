<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="radar_perfil_view_list" model="ir.ui.view">
    <field name="name">radar.perfil.list</field>
    <field name="model">radar.perfil</field>
    <field name="arch" type="xml">
      <list decoration-danger="ultimo_error">
        <field name="name" />
        <field name="user_id" widget="many2one_avatar_user" />
        <field name="cpv" />
        <field name="state_ids" widget="many2many_tags" />
        <field name="importe_minimo" />
        <field name="ultima_importacion" />
        <field name="licitacion_count" />
        <field name="ultimo_error" column_invisible="1" />
        <field name="company_id" groups="base.group_multi_company" optional="show" />
        <field name="currency_id" column_invisible="1" />
      </list>
    </field>
  </record>

  <record id="radar_perfil_view_form" model="ir.ui.view">
    <field name="name">radar.perfil.form</field>
    <field name="model">radar.perfil</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_importar"
            type="object"
            string="Import now"
            class="btn-primary"
            groups="radar_licitaciones.group_radar_responsable"
          />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_ver_licitaciones" type="object" class="oe_stat_button" icon="fa-gavel">
              <field name="licitacion_count" widget="statinfo" string="Tenders" />
            </button>
          </div>
          <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
          <div class="alert alert-warning" role="alert" invisible="not ultimo_error">
            <strong>The last import failed.</strong>
            <field name="ultimo_error" />
          </div>
          <div class="oe_title">
            <label for="name" />
            <h1>
              <field name="name" placeholder="e.g. IT services in Murcia" />
            </h1>
          </div>
          <group>
            <group string="What">
              <field name="cpv" placeholder="72, 48" />
              <field name="palabras" placeholder='e.g. software -"cleaning"' />
              <field name="importe_minimo" />
              <field name="importe_maximo" />
              <field name="solo_abiertas" />
            </group>
            <group string="Where and who">
              <field name="state_ids" widget="many2many_tags" options="{'no_create': True}" />
              <field name="user_id" widget="many2one_avatar_user" />
              <field name="company_id" groups="base.group_multi_company" />
              <field name="active" invisible="1" />
              <field name="currency_id" invisible="1" />
            </group>
          </group>
          <group string="Import">
            <group>
              <field name="ultima_importacion" />
              <field name="dias_primera_importacion" invisible="ultima_importacion" />
            </group>
          </group>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="radar_perfil_view_search" model="ir.ui.view">
    <field name="name">radar.perfil.search</field>
    <field name="model">radar.perfil</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="user_id" />
        <filter name="con_error" string="Import failed" domain="[('ultimo_error', '!=', False)]" />
        <separator />
        <filter name="archivados" string="Archived" domain="[('active', '=', False)]" />
      </search>
    </field>
  </record>

  <record id="radar_perfil_action" model="ir.actions.act_window">
    <field name="name">Search profiles</field>
    <field name="res_model">radar.perfil</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first search profile</p>
      <p>
        Say which CPV codes, provinces and amounts interest the company. Every day the matching tenders are imported.
      </p>
    </field>
  </record>
</odoo>
