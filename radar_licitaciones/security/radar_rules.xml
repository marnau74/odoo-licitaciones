<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
  <!-- Multiempresa: cada usuario solo ve lo de las compañías en las que está trabajando. -->
  <record id="radar_perfil_rule_company" model="ir.rule">
    <field name="name">Tender profiles: multi-company</field>
    <field name="model_id" ref="model_radar_perfil" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="radar_licitacion_rule_company" model="ir.rule">
    <field name="name">Tenders: multi-company</field>
    <field name="model_id" ref="model_radar_licitacion" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
